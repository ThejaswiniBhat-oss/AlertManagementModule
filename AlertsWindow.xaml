<Window x:Class="AlertModule.AlertsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Alert Management" Height="520" Width="620"
        Background="White">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0" Background="White">
            <TabItem Header="Alerts">
                <Grid Background="White" Margin="5">
                    <ListBox x:Name="AlertsListBox" Background="White" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="LightGray" BorderThickness="0,0,0,1" Padding="6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding Priority}"
                                                   Foreground="Blue" FontWeight="Bold"
                                                   VerticalAlignment="Center"/>

                                        <TextBlock Grid.Column="1" Text="{Binding Message}"
                                                   Foreground="Black" TextWrapping="Wrap"
                                                   VerticalAlignment="Center" Margin="10,0"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
            <TextBlock Text="Test:" Foreground="Blue" FontWeight="Bold"
                       VerticalAlignment="Center" Margin="0,0,10,0"/>
            <Button Content="Add High Alert" Click="AddHigh_Click" Margin="5,0" Padding="10,5"/>
            <Button Content="Add Medium Alert" Click="AddMedium_Click" Margin="5,0" Padding="10,5"/>
            <Button Content="Add Low Alert" Click="AddLow_Click" Margin="5,0" Padding="10,5"/>
        </StackPanel>

        <Button Grid.Row="2" Content="Clear All" Click="ClearAll_Click"
                HorizontalAlignment="Center" Margin="0,10,0,0" Padding="20,6"/>
    </Grid>
</Window>
